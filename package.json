{
  "name": "gymos",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:local-db": "concurrently -n supabase,turbo -c yellow,cyan \"supabase start\" \"turbo run dev\"",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "check:i18n": "node scripts/check-i18n-key-parity.mjs",
    "check:migrations": "node scripts/check-migration-guardrails.mjs",
    "test:guardrails": "node --test scripts/__tests__/*.test.mjs",
    "check:claims": "node scripts/claim-inventory.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "supabase": "2.109.0",
    "turbo": "^2.10.3",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "@xmldom/xmldom@>=0.9.0 <0.9.12": "0.9.12",
      "browserslist@<4.28.7": "4.28.9",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "compression@<1.8.2": "1.8.2",
      "decode-uri-component@<0.5.0": "0.5.0",
      "dompurify@<3.4.16": "3.4.16",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.23": "8.5.29",
      "postcss-selector-parser@<7.1.6": "7.1.6",
      "sharp@<0.35.5": "0.35.5",
      "shell-quote@<1.11.0": "1.12.0",
      "source-map-js@<1.2.2": "1.2.2",
      "undici@>=8.0.0 <8.10.2": "8.11.2"
    }
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  }
}
