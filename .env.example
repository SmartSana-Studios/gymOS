# Supabase (apps/dashboard, apps/super-admin, apps/mobile)
# Next.js (dashboard, super-admin) and Expo (mobile) name this pair
# differently for the same value -- Next.js code reads
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (see apps/dashboard/lib/supabase/client.ts,
# apps/super-admin/lib/supabase/client.ts), Expo code reads
# EXPO_PUBLIC_SUPABASE_ANON_KEY (see apps/mobile/src/lib/supabase.ts) --
# grep-confirmed against actual usage, not renamed for consistency's sake.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=   # dashboard, super-admin
EXPO_PUBLIC_SENTRY_DSN=   # mobile

# PostHog (dashboard, mobile — NOT super-admin, see Dev Notes)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
