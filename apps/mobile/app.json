{
  "expo": {
    "name": "GymOS",
    "slug": "gymos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.gymos.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.gymos.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GymOS to access your photos so you can set a profile picture.",
          "cameraPermission": "Allow GymOS to access your camera so you can take a profile picture."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "GymOS needs camera access to scan your gym's check-in QR code."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
