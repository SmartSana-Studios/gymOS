# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
# EXPO_PUBLIC_ prefix is required for Expo to inline these into the client
# bundle (mirrors NEXT_PUBLIC_ in apps/dashboard/apps/super-admin) -- only
# ever put the publishable/anon key here, never a service-role secret.
EXPO_PUBLIC_SUPABASE_URL=your-project-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Story 9.5: PostHog project API key/host -- same NEXT_PUBLIC_/EXPO_PUBLIC_
# "safe to expose client-side" reasoning as the Supabase keys above.
EXPO_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Story 9.5: local-dev env tag (each EAS build profile sets its own copy
# via eas.json's per-profile "env", so this .env/.env.example copy is only
# read when running the Expo dev client directly, not via an EAS build).
EXPO_PUBLIC_APP_ENV=development
