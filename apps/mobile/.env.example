# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
# EXPO_PUBLIC_ prefix is required for Expo to inline these into the client
# bundle (mirrors NEXT_PUBLIC_ in apps/dashboard/apps/super-admin) -- only
# ever put the publishable/anon key here, never a service-role secret.
EXPO_PUBLIC_SUPABASE_URL=your-project-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
