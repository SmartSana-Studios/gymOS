# apps/landing -- the public marketing site at https://gymosapps.com
#
# Every var here is NEXT_PUBLIC_-prefixed because this app has no server-side
# secrets: it is a static page, and each value ends up in an href the browser
# must be able to read. Nothing here is sensitive.
#
# All of them have working defaults in lib/config.ts EXCEPT the WhatsApp
# number -- the page builds and renders correctly from a bare checkout.

# The sales/support WhatsApp number, E.164 DIGITS ONLY: no "+", no spaces,
# no dashes (this is the shape wa.me requires). Cameroon example:
#   NEXT_PUBLIC_WHATSAPP_NUMBER=237670000000
#
# Deliberately has no default. While this is unset, the "Talk to us on
# WhatsApp" buttons fall back to a mailto: of the support address and
# relabel themselves -- a working email CTA rather than a dead
# wa.me/undefined link. Set this on the Vercel project to turn WhatsApp on.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Monitored inbox. Must stay in step with LEGAL_DETAILS.supportEmail in
# apps/dashboard/lib/legal/details.ts, which is the data-deletion contact
# route declared to Play -- if one changes, change both.
NEXT_PUBLIC_SUPPORT_EMAIL=hello@gymosapps.com

# Where "Owner login" and the privacy-policy link point. The dashboard's own
# domain, not this site's. /privacy on this site 308-redirects here.
NEXT_PUBLIC_DASHBOARD_URL=https://owner.gymosapps.com

# This site's own origin, used for metadataBase / canonical / og:url.
NEXT_PUBLIC_SITE_URL=https://gymosapps.com

# Public store listings for the member app. Defaulted in lib/config.ts to the
# real published listings (both confirmed live 2026-10-02); set here only to
# point a preview deploy somewhere else.
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id6798403711
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.smartsana.gymos

# Social and company links.
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/gymosapp
NEXT_PUBLIC_GETSOCIAL_URL=https://getsocial.digital

# Testimonial section kill switch. Leave unset/false until real gym owners
# have given real, attributable quotes AND those quotes are in
# testimonials.items for BOTH locales in lib/copy.ts. Setting this to "true"
# with an empty dictionary renders nothing by design.
NEXT_PUBLIC_SHOW_TESTIMONIALS=false
