# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only -- never NEXT_PUBLIC_-prefixed (would leak to the browser
# bundle). Used exclusively by lib/supabase/admin.ts to call
# supabase.auth.admin.* when provisioning a new gym owner's account
# (Story 1.5). Get this from your project settings > API > service_role
# secret (or the Supabase CLI's "secret key" for local dev).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Server-only. Origin of apps/dashboard -- referenced in the temp-password
# WhatsApp message (Story 1.11) so a new owner has a login URL, and used to
# build the AD-01 login page link. No /auth/confirm route is used anymore
# (Story 1.5's recovery-link mechanism was replaced -- see docs/decisions.md).
#
# In production this is the dashboard's custom domain, NOT this app's own
# host and NOT the Vercel-generated URL:
#   DASHBOARD_APP_URL=https://app.gymosapps.com
# (super-admin itself is served at https://portal.gymosapps.com.) A new gym
# owner receives this value as their login link over WhatsApp, so a stale
# value here is the first thing a real customer sees fail.
DASHBOARD_APP_URL=http://127.0.0.1:3000

# Server-only. Story 1.11: sends the new gym owner's temp password over
# WhatsApp via Twilio's Content API, reusing Story 2.1's already-approved
# `verifications_2fa_template`. Separate credentials/config from the Send SMS
# Hook's own Supabase Edge Function secrets (not accessible to a Next.js
# server process) -- copy the same Twilio account/number's values here.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM_NUMBER=whatsapp:+15551234567
TWILIO_WHATSAPP_CONTENT_SID=HX40e31e99442e38ba6ec2024a9fb34459

# Server-only. Story 11.5: the Billing view's "Trigger retry" row action's
# two send channels, ported from apps/dashboard's identical env vars
# (Story 2.10/11.3) rather than shared, per this codebase's own established
# per-app messaging-duplication precedent (AD-7) -- copy the same
# Evolution API instance / Twilio account's values here.
EVOLUTION_API_BASE_URL=https://your-evolution-api-instance.example.com
EVOLUTION_API_KEY=your-evolution-api-key
# TWILIO_SMS_FROM_NUMBER is a separate, new number from
# TWILIO_WHATSAPP_FROM_NUMBER above -- a number approved/configured for
# Twilio's WhatsApp Business API is not necessarily SMS-capable.
TWILIO_SMS_FROM_NUMBER=+15551234567
