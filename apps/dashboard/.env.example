# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only -- never NEXT_PUBLIC_-prefixed (would leak to the browser
# bundle). Used exclusively by lib/supabase/admin.ts to call
# supabase.auth.admin.* (Story 2.3's findOrCreateUserByPhone -- provisioning
# a placeholder auth.users row for a newly-created member, or looking one up
# by phone to reuse across gyms). Get this from your project settings > API
# > service_role secret (or the Supabase CLI's "secret key" for local dev).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Story 2.10: same self-hosted Evolution API instance already provisioned
# for supabase/.env (Story 2.9) -- used by lib/messaging/EvolutionApiMessageProvider.ts
# to send the automated member-invite WhatsApp message. Server-only, never
# NEXT_PUBLIC_-prefixed. Get these from whoever manages the Evolution API
# instance (same values as supabase/.env's own copy).
EVOLUTION_API_BASE_URL=https://your-evolution-api-instance.example.com
EVOLUTION_API_KEY=your-evolution-api-key

# Story 9.2: apps/dashboard's own copy of the URL it runs at, used to build
# the staff-activation WhatsApp message's login link. Distinct from
# apps/super-admin's own DASHBOARD_APP_URL (that copy points super-admin AT
# the dashboard; this copy is the dashboard pointing at itself) -- same
# value in local dev, may differ in deployed environments.
DASHBOARD_APP_URL=http://127.0.0.1:3000
