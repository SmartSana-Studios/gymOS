# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only -- never NEXT_PUBLIC_-prefixed (would leak to the browser
# bundle). Used exclusively by lib/supabase/admin.ts to call
# supabase.auth.admin.* (Story 2.3's findOrCreateUserByPhone -- provisioning
# a placeholder auth.users row for a newly-created member, or looking one up
# by phone to reuse across gyms). Get this from your project settings > API
# > service_role secret (or the Supabase CLI's "secret key" for local dev).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Story 2.10: same self-hosted Evolution API instance already provisioned
# for supabase/.env (Story 2.9) -- used by lib/messaging/EvolutionApiMessageProvider.ts
# to send the automated member-invite WhatsApp message. Server-only, never
# NEXT_PUBLIC_-prefixed. Get these from whoever manages the Evolution API
# instance (same values as supabase/.env's own copy).
EVOLUTION_API_BASE_URL=https://your-evolution-api-instance.example.com
EVOLUTION_API_KEY=your-evolution-api-key

# Story 9.2: apps/dashboard's own copy of the URL it runs at, used to build
# the staff-activation WhatsApp message's login link. Distinct from
# apps/super-admin's own DASHBOARD_APP_URL (that copy points super-admin AT
# the dashboard; this copy is the dashboard pointing at itself) -- same
# value in local dev, may differ in deployed environments.
DASHBOARD_APP_URL=http://127.0.0.1:3000

# Story 9.5: PostHog project API key/host. NEXT_PUBLIC_-prefixed because
# it's safe to expose client-side by design (a project API key, not a
# secret, unlike SUPABASE_SERVICE_ROLE_KEY above) -- Next.js reads
# NEXT_PUBLIC_* vars in server code too (lib/analytics.ts), it just also
# inlines them into the client bundle (instrumentation-client.ts), so one
# pair of vars serves both.
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Story 11.3: SaaS billing-due reminders (lib/messaging/sendTwilioSms.ts) and
# the saas-billing-reminders Vercel Cron route. TWILIO_ACCOUNT_SID/AUTH_TOKEN
# are the same Twilio account already used for the temp-password WhatsApp
# send in apps/super-admin's own .env -- copy those same values here.
# TWILIO_SMS_FROM_NUMBER is a separate, new env var from
# apps/super-admin's TWILIO_WHATSAPP_FROM_NUMBER -- a WhatsApp-approved
# sender is not necessarily SMS-capable, so confirm with whoever manages the
# Twilio account whether an existing SMS-capable number can be reused or a
# new one needs provisioning.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_SMS_FROM_NUMBER=+15551234567

# Story 11.3: authenticates Vercel's own invocation of
# app/api/cron/saas-billing-reminders/route.ts (Authorization: Bearer
# $CRON_SECRET, sent automatically by Vercel when this env var is set on the
# Vercel project -- see https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs).
# A random string of at least 16 characters.
CRON_SECRET=a-long-random-string

# Story 11.3: kill switch for the saas-billing-reminders Vercel Cron job.
# Every existing gym was backfilled to a 3-month billing runway in Story
# 11.2 -- once this ships, real Owners of already-past-due gyms start
# receiving real automated SMS/WhatsApp billing texts on the job's own
# schedule. Default enabled (true) unless explicitly set to "false"
# (case/whitespace-insensitive), same shape as TARAMONEY_INITIATION_ENABLED.
SAAS_BILLING_REMINDERS_ENABLED=true
